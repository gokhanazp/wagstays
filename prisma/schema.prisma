// Supabase Postgres. DATABASE_URL = transaction pooler (runtime), DIRECT_URL = session pooler (migrations).
// Enum-like fields are plain strings validated in src/lib/constants.ts.
// RLS is enabled on every table with no policies: only the server (Prisma, postgres role) reads data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model City {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  province       String
  provinceCode   String
  currency       String          @default("CAD")
  taxRateBps     Int             @default(1300) // HST 13% for Ontario, in basis points
  timeZone       String          @default("America/Toronto")
  isActive       Boolean         @default(false)
  lat            Float
  lng            Float
  neighbourhoods Neighbourhood[]
  sitters        SitterProfile[]
  createdAt      DateTime        @default(now())
}

model Neighbourhood {
  id      String          @id @default(cuid())
  cityId  String
  city    City            @relation(fields: [cityId], references: [id])
  slug    String
  name    String
  lat     Float
  lng     Float
  sitters SitterProfile[]
  applications SitterApplication[]

  @@unique([cityId, slug])
}

model User {
  id           String              @id @default(uuid()) // = Supabase auth.users.id
  email        String              @unique
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  role         String              @default("OWNER") // OWNER | SITTER | ADMIN
  suspended    Boolean             @default(false)
  wagPointsCents Int               @default(0)
  createdAt    DateTime            @default(now())
  pets         Pet[]
  sitter       SitterProfile?
  bookings     Booking[]
  favorites    Favorite[]
  reviews      Review[]
  applications SitterApplication[]
  conversationsAsOwner Conversation[] @relation("ConversationOwner")
  messages     Message[]
  auditLogs    AuditLog[]
}

model Pet {
  id            String    @id @default(cuid())
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  species       String    // DOG | CAT | OTHER
  breed         String?
  ageYears      Float?
  size          String?   // SMALL | MEDIUM | LARGE | GIANT
  sex           String?   // MALE | FEMALE
  neutered      Boolean   @default(false)
  rabiesVaccinated Boolean @default(false)
  microchip     String?
  photoUrl      String?
  archivedAt    DateTime? // archived pets keep their booking history but are hidden from the owner
  traits        PetTrait[]
  bookings      Booking[]
  createdAt     DateTime  @default(now())
}

model PetTrait {
  id    String @id @default(cuid())
  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  label String
  icon  String?
  tone  String @default("neutral") // neutral | primary | warning
}

model SitterProfile {
  id                String        @id @default(cuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug              String        @unique
  displayName       String
  headline          String
  bio               String        // short blurb for cards
  about             String?       // long-form profile text, paragraphs separated by blank lines
  residentPetName   String?
  cityId            String
  city              City          @relation(fields: [cityId], references: [id])
  neighbourhoodId   String
  neighbourhood     Neighbourhood @relation(fields: [neighbourhoodId], references: [id])
  locationNote      String?       // e.g. "Near High Park"
  lat               Float
  lng               Float
  serviceRadiusKm   Float         @default(3)
  serviceAreaNote   String?
  avatarUrl         String
  cardPhotoUrl      String?       // tall photo used on search & home cards
  mapPhotoUrl       String?       // small thumbnail in the map preview card
  yearsExperience   Int           @default(0)
  isSuperSitter     Boolean       @default(false)
  instantBook       Boolean       @default(false)
  idVerified        Boolean       @default(false)
  backgroundChecked Boolean       @default(false)
  firstAidCertified Boolean       @default(false)
  vetKnowledge      Boolean       @default(false)
  professionalTrainer Boolean     @default(false)
  responseTimeMins  Int           @default(60)
  repeatClientPct   Int           @default(0)
  rating            Float         @default(0)   // derived: imported + visible WagStays reviews
  reviewCount       Int           @default(0)   // derived: importedReviewCount + visible reviews
  importedReviewCount Int         @default(0)   // reviews carried over from before WagStays (no rows)
  importedRating    Float         @default(0)
  ratingCommunication Float       @default(0)
  ratingReliability Float         @default(0)
  ratingCare        Float         @default(0)
  completedBookings Int           @default(0)
  homeType          String?       // HOUSE_WITH_YARD | APARTMENT | CONDO_BALCONY
  homeTitle         String?
  homeNote          String?
  hasYard           Boolean       @default(false)
  smokeFree         Boolean       @default(true)
  hasChildren       Boolean       @default(false)
  hasOtherPets      Boolean       @default(false)
  otherPetsNote     String?
  acceptsSmall      Boolean       @default(true)
  acceptsMedium     Boolean       @default(true)
  acceptsLarge      Boolean       @default(false)
  acceptsGiant      Boolean       @default(false)
  featured          Boolean       @default(false)
  featuredBadge     String?       // e.g. "Super Sitter", "Cat Lover"
  featuredBadgeIcon String?
  credential        String?       // short line under the name, e.g. "Vet Technician"
  highlight         String?       // pill like "Fast Response (<10 min)"
  highlightIcon     String?
  quote             String?       // short first-person blurb for home cards
  status            String        @default("ACTIVE") // ACTIVE | PAUSED
  services          Service[]
  photos            SitterPhoto[]
  tags              SitterTag[]
  skills            SitterSkill[]
  reviews           Review[]
  bookings          Booking[]
  favorites         Favorite[]
  conversations     Conversation[]
  application       SitterApplication?
  createdAt         DateTime      @default(now())
}

model SitterPhoto {
  id        String        @id @default(cuid())
  sitterId  String
  sitter    SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int           @default(0)
}

// Feature chips shown on search/listing cards (e.g. "Large Yard", "Live GPS Tracking")
model SitterTag {
  id        String        @id @default(cuid())
  sitterId  String
  sitter    SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  label     String
  icon      String
  tone      String        @default("neutral") // neutral | primary
  sortOrder Int           @default(0)
}

// Skill pills in the profile "About" section (e.g. "Large Breed Experience")
model SitterSkill {
  id        String        @id @default(cuid())
  sitterId  String
  sitter    SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  label     String
  emoji     String?
  sortOrder Int           @default(0)
}

model Service {
  id           String        @id @default(cuid())
  sitterId     String
  sitter       SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  type         String        // DOG_WALKING | BOARDING | DAY_CARE | DROP_IN
  priceCents   Int
  unit         String        // WALK | NIGHT | DAY | VISIT
  durationMins Int?
  description  String?
  extraNote    String?
  active       Boolean       @default(true)
  bookings     Booking[]
}

model Booking {
  id                 String        @id @default(cuid())
  ownerId            String
  owner              User          @relation(fields: [ownerId], references: [id])
  sitterId           String
  sitter             SitterProfile @relation(fields: [sitterId], references: [id])
  serviceId          String
  service            Service       @relation(fields: [serviceId], references: [id])
  petId              String
  pet                Pet           @relation(fields: [petId], references: [id])
  startAt            DateTime
  endAt              DateTime
  recurringWeekly    Boolean       @default(false)
  meetAndGreet       Boolean       @default(false) // owner asked for a free Meet & Greet first
  status             String        @default("DRAFT") // DRAFT | PENDING | CONFIRMED | DECLINED | COMPLETED | CANCELLED
  meetingAddress     String?
  leashPreference    String?
  otherAnimalsReaction String?
  feedingRules       String?
  notes              String?
  gpsUpdates         Boolean       @default(true)
  emergencyName      String?
  emergencyPhone     String?
  vetClinic          String?
  vetPhone           String?
  subtotalCents      Int           @default(0)
  protectionFeeCents Int           @default(0)
  serviceFeeCents    Int           @default(0)
  discountCents      Int           @default(0)
  taxCents           Int           @default(0)
  totalCents         Int           @default(0)
  cardLast4          String?
  cardBrand          String?
  confirmedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledBy        String?       // OWNER | SITTER | ADMIN
  cancelReason       String?
  sitterNote         String?       // message from the sitter when accepting / declining
  review             Review?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt
}

model Review {
  id           String        @id @default(cuid())
  sitterId     String
  sitter       SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?         @relation(fields: [authorId], references: [id])
  authorName   String
  authorAvatar String?
  petLabel     String?       // e.g. "Milo (French Bulldog) Parent"
  rating       Int
  body         String
  verifiedBooking Boolean    @default(true)
  walkSummary  String?       // e.g. "2.8 km · 58 min · Trinity Bellwoods"
  walkPhotoUrl String?
  featuredOnHome Boolean     @default(false)
  bookingId    String?       @unique
  booking      Booking?      @relation(fields: [bookingId], references: [id])
  hidden       Boolean       @default(false) // hidden by admin moderation
  createdAt    DateTime      @default(now())
}

model Favorite {
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sitterId  String
  sitter    SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([userId, sitterId])
}

model SitterApplication {
  id              String               @id @default(cuid())
  trackingCode    String               @unique
  userId          String?
  user            User?                @relation(fields: [userId], references: [id])
  status          String               @default("IN_REVIEW") // IN_REVIEW | MEET_GREET | APPROVED | REJECTED
  firstName       String
  lastName        String
  email           String
  phone           String?
  neighbourhood   String?              // display name at the time of applying
  neighbourhoodId String?
  neighbourhoodRef Neighbourhood?      @relation(fields: [neighbourhoodId], references: [id])
  experience      String               // "1-3" | "3-6" | "6+" | "VET"
  acceptsSmall    Boolean              @default(false)
  acceptsMedium   Boolean              @default(false)
  acceptsLarge    Boolean              @default(false)
  acceptsGiant    Boolean              @default(false)
  certFirstAid    Boolean              @default(false)
  certMedication  Boolean              @default(false)
  certPuppy       Boolean              @default(false)
  certBehaviour   Boolean              @default(false)
  homeType        String
  smokeFree       Boolean              @default(false)
  noChildren      Boolean              @default(false)
  ownPets         Boolean              @default(false)
  fencedYard      Boolean              @default(false)
  bio             String
  idDocumentName  String?
  backgroundCheckName String?
  meetGreetAt     DateTime?
  reviewedAt      DateTime?
  reviewNotes     String?              // internal admin notes / rejection reason
  sitterProfileId String?              @unique
  sitterProfile   SitterProfile?       @relation(fields: [sitterProfileId], references: [id])
  services        ApplicationService[]
  files           ApplicationFile[]
  createdAt       DateTime             @default(now())
}

// Uploaded verification documents and home photos, stored in the private "documents" bucket.
model ApplicationFile {
  id            String            @id @default(cuid())
  applicationId String
  application   SitterApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String            // ID_DOCUMENT | BACKGROUND_CHECK | HOME_PHOTO
  path          String            @unique // object path inside the bucket
  fileName      String
  contentType   String
  sizeBytes     Int
  createdAt     DateTime          @default(now())

  @@index([applicationId])
}

model ApplicationService {
  id            String            @id @default(cuid())
  applicationId String
  application   SitterApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String
  priceCents    Int
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Single-row platform configuration edited from /admin/settings (id is always "default").
model PlatformSettings {
  id                     String   @id @default("default")
  wagShieldFeeCents      Int      @default(350)
  serviceFeeCents        Int      @default(225)
  wagPointsDiscountCents Int      @default(300)
  vetCoverageCents       Int      @default(500000)
  supportEmail           String   @default("support@wagstays.ca")
  supportPhone           String   @default("+1 (416) 555-0142")
  updatedAt              DateTime @default(now()) @updatedAt
}

model Conversation {
  id            String        @id @default(cuid())
  ownerId       String
  owner         User          @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sitterId      String
  sitter        SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime      @default(now())
  ownerReadAt   DateTime?
  sitterReadAt  DateTime?
  messages      Message[]
  createdAt     DateTime      @default(now())

  @@unique([ownerId, sitterId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// Every admin mutation writes a row here (see src/lib/audit.ts).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String   // e.g. "city.activate", "application.approve"
  entityType String   // City | SitterApplication | SitterProfile | Booking | User | Review | PlatformSettings
  entityId   String
  details    String?  // JSON string with before/after or notes
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

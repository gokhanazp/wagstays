// Supabase Postgres. DATABASE_URL = transaction pooler (runtime), DIRECT_URL = session pooler (migrations).
// Enum-like fields are plain strings validated in src/lib/constants.ts.
// RLS is enabled on every table with no policies: only the server (Prisma, postgres role) reads data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model City {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  province       String
  provinceCode   String
  currency       String          @default("CAD")
  taxRateBps     Int             @default(1300) // HST 13% for Ontario, in basis points
  timeZone       String          @default("America/Toronto")
  isActive       Boolean         @default(false)
  lat            Float
  lng            Float
  neighbourhoods Neighbourhood[]
  sitters        SitterProfile[]
  createdAt      DateTime        @default(now())
}

model Neighbourhood {
  id      String          @id @default(cuid())
  cityId  String
  city    City            @relation(fields: [cityId], references: [id])
  slug    String
  name    String
  lat     Float
  lng     Float
  sitters SitterProfile[]
  applications SitterApplication[]

  @@unique([cityId, slug])
}

model User {
  id           String              @id @default(uuid()) // = Supabase auth.users.id
  email        String              @unique
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  role         String              @default("OWNER") // OWNER | SITTER | ADMIN
  suspended    Boolean             @default(false)
  approvalStatus String            @default("APPROVED") // APPROVED | PENDING | REJECTED — pet parents, only used when PlatformSettings.requireOwnerApproval is on
  approvedAt   DateTime?
  approvalNote String?             // admin note when rejecting / approving
  wagPointsCents Int               @default(0)
  referralCode String?             @unique // share link code, e.g. "EMILY7K2"
  referredById String?
  referredBy   User?               @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]              @relation("Referrals")
  deletedAt    DateTime?           // account closed (PIPEDA erasure): personal data anonymised
  createdAt    DateTime            @default(now())
  pets         Pet[]
  sitter       SitterProfile?
  bookings     Booking[]
  favorites    Favorite[]
  reviews      Review[]
  applications SitterApplication[]
  conversationsAsOwner Conversation[] @relation("ConversationOwner")
  messages     Message[]
  auditLogs    AuditLog[]
  pointsLedger WagPointsEntry[]
  ticketsOpened SupportTicket[]    @relation("TicketOpener")
  ticketMessages SupportTicketMessage[]
  ownerReviewsReceived OwnerReview[] @relation("OwnerReviewSubject")
  pushSubscriptions PushSubscription[]
}

model Pet {
  id            String    @id @default(cuid())
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  species       String    // DOG | CAT | OTHER
  speciesOther  String?   // what the pet is when species = OTHER (e.g. "Rabbit")
  breed         String?
  ageYears      Float?
  size          String?   // SMALL | MEDIUM | LARGE | GIANT
  sex           String?   // MALE | FEMALE
  neutered      Boolean   @default(false)
  rabiesVaccinated Boolean @default(false)
  microchip     String?
  photoUrl      String?
  archivedAt    DateTime? // archived pets keep their booking history but are hidden from the owner
  traits        PetTrait[]
  bookings      Booking[]
  bookingPets   BookingPet[]
  createdAt     DateTime  @default(now())
}

model BookingPet {
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  petId     String
  pet       Pet     @relation(fields: [petId], references: [id])

  @@id([bookingId, petId])
  @@index([petId])
}

model PetTrait {
  id    String @id @default(cuid())
  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  label String
  icon  String?
  tone  String @default("neutral") // neutral | primary | warning
}

model SitterProfile {
  id                String        @id @default(cuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug              String        @unique
  displayName       String
  headline          String
  bio               String        // short blurb for cards
  about             String?       // long-form profile text, paragraphs separated by blank lines
  residentPetName   String?
  cityId            String
  city              City          @relation(fields: [cityId], references: [id])
  neighbourhoodId   String
  neighbourhood     Neighbourhood @relation(fields: [neighbourhoodId], references: [id])
  locationNote      String?       // e.g. "Near High Park"
  lat               Float
  lng               Float
  serviceRadiusKm   Float         @default(3)
  serviceAreaNote   String?
  avatarUrl         String
  cardPhotoUrl      String?       // tall photo used on search & home cards
  mapPhotoUrl       String?       // small thumbnail in the map preview card
  yearsExperience   Int           @default(0)
  isSuperSitter     Boolean       @default(false)
  instantBook       Boolean       @default(false)
  idVerified        Boolean       @default(false)
  backgroundChecked Boolean       @default(false)
  firstAidCertified Boolean       @default(false)
  vetKnowledge      Boolean       @default(false)
  professionalTrainer Boolean     @default(false)
  responseTimeMins  Int           @default(60)
  repeatClientPct   Int           @default(0)
  rating            Float         @default(0)   // derived: imported + visible WagStays reviews
  reviewCount       Int           @default(0)   // derived: importedReviewCount + visible reviews
  importedReviewCount Int         @default(0)   // reviews carried over from before WagStays (no rows)
  importedRating    Float         @default(0)
  ratingCommunication Float       @default(0)
  ratingReliability Float         @default(0)
  ratingCare        Float         @default(0)
  completedBookings Int           @default(0)
  homeType          String?       // HOUSE_WITH_YARD | APARTMENT | CONDO_BALCONY
  homeTitle         String?
  homeNote          String?
  hasYard           Boolean       @default(false)
  smokeFree         Boolean       @default(true)
  hasChildren       Boolean       @default(false)
  hasOtherPets      Boolean       @default(false)
  otherPetsNote     String?
  acceptsSmall      Boolean       @default(true)
  acceptsMedium     Boolean       @default(true)
  acceptsLarge      Boolean       @default(false)
  acceptsGiant      Boolean       @default(false)
  featured          Boolean       @default(false)
  featuredBadge     String?       // e.g. "Super Sitter", "Cat Lover"
  featuredBadgeIcon String?
  credential        String?       // short line under the name, e.g. "Vet Technician"
  highlight         String?       // pill like "Fast Response (<10 min)"
  highlightIcon     String?
  quote             String?       // short first-person blurb for home cards
  status            String        @default("ACTIVE") // ACTIVE | PAUSED
  boardingCapacity  Int           @default(1)   // pets that can board / attend day care at the same time
  noticeHours       Int           @default(12)  // minimum notice before a booking can start
  services          Service[]
  photos            SitterPhoto[]
  tags              SitterTag[]
  skills            SitterSkill[]
  reviews           Review[]
  bookings          Booking[]
  favorites         Favorite[]
  conversations     Conversation[]
  application       SitterApplication?
  availability      SitterAvailability[]
  timeOff           SitterTimeOff[]
  species           SitterSpecies[]
  ownerReviews      OwnerReview[]
  createdAt         DateTime      @default(now())
}

// Weekly opening hours, in the city's local time. Several rows per weekday are allowed (e.g. 8–11 and 17–20).
model SitterAvailability {
  id          String        @id @default(cuid())
  sitterId    String
  sitter      SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  weekday     Int           // 0 = Sunday … 6 = Saturday
  startMinute Int           // minutes after midnight, e.g. 480 = 8:00
  endMinute   Int

  @@index([sitterId, weekday])
}

// Days the sitter is away / fully booked outside the platform (inclusive local dates, YYYY-MM-DD).
model SitterTimeOff {
  id        String        @id @default(cuid())
  sitterId  String
  sitter    SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  startDate String
  endDate   String
  note      String?
  createdAt DateTime      @default(now())

  @@index([sitterId, startDate])
}

// Kinds of animals a sitter cares for (see PET_KINDS in src/lib/pets.ts).
model SitterSpecies {
  sitterId String
  sitter   SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  kind     String        // DOG | CAT | RABBIT | GUINEA_PIG | HAMSTER | BIRD | FERRET | REPTILE | FISH | OTHER

  @@id([sitterId, kind])
}

model SitterPhoto {
  id        String        @id @default(cuid())
  sitterId  String
  sitter    SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int           @default(0)
}

// Feature chips shown on search/listing cards (e.g. "Large Yard", "Live GPS Tracking")
model SitterTag {
  id        String        @id @default(cuid())
  sitterId  String
  sitter    SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  label     String
  icon      String
  tone      String        @default("neutral") // neutral | primary
  sortOrder Int           @default(0)
}

// Skill pills in the profile "About" section (e.g. "Large Breed Experience")
model SitterSkill {
  id        String        @id @default(cuid())
  sitterId  String
  sitter    SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  label     String
  emoji     String?
  sortOrder Int           @default(0)
}

model Service {
  id           String        @id @default(cuid())
  sitterId     String
  sitter       SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  type         String        // DOG_WALKING | BOARDING | DAY_CARE | DROP_IN
  priceCents   Int
  unit         String        // WALK | NIGHT | DAY | VISIT
  durationMins Int?
  description  String?
  extraNote    String?
  active       Boolean       @default(true)
  // Rate add-ons (all optional; null = not offered / no surcharge)
  maxPetsPerBooking       Int  @default(3)  // most pets in one booking (e.g. dogs per walk); boarding also limited by capacity
  additionalPetPriceCents Int? // per extra pet, per night/day/visit; null = only one pet per booking
  holidayPriceCents       Int? // replaces the base price on statutory holidays (see src/lib/holidays.ts)
  puppyPriceCents         Int? // surcharge per puppy (< 1 year) per night/day/visit
  bookings     Booking[]
}

model Booking {
  id                 String        @id @default(cuid())
  ownerId            String
  owner              User          @relation(fields: [ownerId], references: [id])
  sitterId           String
  sitter             SitterProfile @relation(fields: [sitterId], references: [id])
  serviceId          String
  service            Service       @relation(fields: [serviceId], references: [id])
  petId              String
  pet                Pet           @relation(fields: [petId], references: [id]) // primary pet (first selected)
  pets               BookingPet[]  // every pet in the booking, including the primary one
  petCount           Int           @default(1)  // counts towards the sitter's capacity
  startAt            DateTime
  endAt              DateTime
  recurringWeekly    Boolean       @default(false)
  quantity           Int           @default(1)   // nights (boarding), days (day care) or visits/walks for this booking
  seriesId           String?       // weekly recurring bookings share a series id (one row per occurrence)
  meetAndGreet       Boolean       @default(false) // owner asked for a free Meet & Greet first
  status             String        @default("DRAFT") // DRAFT | PENDING | CONFIRMED | DECLINED | COMPLETED | CANCELLED
  meetingAddress     String?
  leashPreference    String?
  otherAnimalsReaction String?
  feedingRules       String?
  notes              String?
  gpsUpdates         Boolean       @default(true)
  emergencyName      String?
  emergencyPhone     String?
  vetClinic          String?
  vetPhone           String?
  subtotalCents      Int           @default(0)  // base + extras (before fees and tax)
  extrasCents        Int           @default(0)  // additional pets, holiday and puppy surcharges included in the subtotal
  priceLines         Json?         // [{ label, amountCents }] as quoted at booking time
  protectionFeeCents Int           @default(0)
  serviceFeeCents    Int           @default(0)
  discountCents      Int           @default(0)
  taxCents           Int           @default(0)
  totalCents         Int           @default(0)
  cardLast4          String?
  cardBrand          String?
  confirmedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledBy        String?       // OWNER | SITTER | ADMIN
  cancelReason       String?
  sitterNote         String?       // message from the sitter when accepting / declining
  review             Review?
  ownerReview        OwnerReview?
  tickets            SupportTicket[]
  pointsEntries      WagPointsEntry[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt

  @@index([sitterId, startAt])
  @@index([seriesId])
}

model Review {
  id           String        @id @default(cuid())
  sitterId     String
  sitter       SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?         @relation(fields: [authorId], references: [id])
  authorName   String
  authorAvatar String?
  petLabel     String?       // e.g. "Milo (French Bulldog) Parent"
  rating       Int
  body         String
  verifiedBooking Boolean    @default(true)
  walkSummary  String?       // e.g. "2.8 km · 58 min · Trinity Bellwoods"
  walkPhotoUrl String?
  featuredOnHome Boolean     @default(false)
  bookingId    String?       @unique
  booking      Booking?      @relation(fields: [bookingId], references: [id])
  hidden       Boolean       @default(false) // hidden by admin moderation
  sitterReply  String?       // public reply from the sitter
  sitterRepliedAt DateTime?
  createdAt    DateTime      @default(now())
}

// Sitter's private rating of a pet parent after a completed booking (visible to sitters & admins only).
model OwnerReview {
  id        String        @id @default(cuid())
  bookingId String        @unique
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sitterId  String
  sitter    SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User          @relation("OwnerReviewSubject", fields: [ownerId], references: [id], onDelete: Cascade)
  rating    Int
  body      String?
  hidden    Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ownerId])
}

model Favorite {
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sitterId  String
  sitter    SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([userId, sitterId])
}

model SitterApplication {
  id              String               @id @default(cuid())
  trackingCode    String               @unique
  userId          String?
  user            User?                @relation(fields: [userId], references: [id])
  status          String               @default("IN_REVIEW") // IN_REVIEW | MEET_GREET | APPROVED | REJECTED
  firstName       String
  lastName        String
  email           String
  phone           String?
  neighbourhood   String?              // display name at the time of applying
  neighbourhoodId String?
  neighbourhoodRef Neighbourhood?      @relation(fields: [neighbourhoodId], references: [id])
  experience      String               // "1-3" | "3-6" | "6+" | "VET"
  acceptsSmall    Boolean              @default(false)
  acceptsMedium   Boolean              @default(false)
  acceptsLarge    Boolean              @default(false)
  acceptsGiant    Boolean              @default(false)
  acceptedKinds   String[]             @default([]) // PET_KINDS the applicant will care for (copied to SitterSpecies on approval)
  certFirstAid    Boolean              @default(false)
  certMedication  Boolean              @default(false)
  certPuppy       Boolean              @default(false)
  certBehaviour   Boolean              @default(false)
  homeType        String
  smokeFree       Boolean              @default(false)
  noChildren      Boolean              @default(false)
  ownPets         Boolean              @default(false)
  fencedYard      Boolean              @default(false)
  bio             String
  idDocumentName  String?
  backgroundCheckName String?
  meetGreetAt     DateTime?
  reviewedAt      DateTime?
  reviewNotes     String?              // internal admin notes / rejection reason
  sitterProfileId String?              @unique
  sitterProfile   SitterProfile?       @relation(fields: [sitterProfileId], references: [id])
  services        ApplicationService[]
  files           ApplicationFile[]
  createdAt       DateTime             @default(now())
}

// Uploaded verification documents and home photos, stored in the private "documents" bucket.
model ApplicationFile {
  id            String            @id @default(cuid())
  applicationId String
  application   SitterApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String            // ID_DOCUMENT | BACKGROUND_CHECK | HOME_PHOTO
  path          String            @unique // object path inside the bucket
  fileName      String
  contentType   String
  sizeBytes     Int
  createdAt     DateTime          @default(now())

  @@index([applicationId])
}

model ApplicationService {
  id            String            @id @default(cuid())
  applicationId String
  application   SitterApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String
  priceCents    Int
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Single-row platform configuration edited from /admin/settings (id is always "default").
model PlatformSettings {
  id                     String   @id @default("default")
  wagShieldFeeCents      Int      @default(350)
  serviceFeeCents        Int      @default(225)
  wagPointsDiscountCents Int      @default(300)
  vetCoverageCents       Int      @default(500000)
  supportEmail           String   @default("support@wagstays.ca")
  supportPhone           String   @default("+1 (416) 555-0142")
  pointsEarnRateBps      Int      @default(500)  // WagPoints earned on completed bookings: 5% of the subtotal
  referralRewardCents    Int      @default(1000) // $10 to both people after the friend's first completed booking
  requireOwnerApproval   Boolean  @default(false) // new pet parents can browse but not book until an admin approves them
  updatedAt              DateTime @default(now()) @updatedAt
}

model Conversation {
  id            String        @id @default(cuid())
  ownerId       String
  owner         User          @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sitterId      String
  sitter        SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime      @default(now())
  ownerReadAt   DateTime?
  sitterReadAt  DateTime?
  messages      Message[]
  createdAt     DateTime      @default(now())

  @@unique([ownerId, sitterId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// Every admin mutation writes a row here (see src/lib/audit.ts).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String   // e.g. "city.activate", "application.approve"
  entityType String   // City | SitterApplication | SitterProfile | Booking | User | Review | PlatformSettings
  entityId   String
  details    String?  // JSON string with before/after or notes
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// Every change to a user's WagPoints balance (earn, spend, refund, referral, admin adjustment).
model WagPointsEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents Int      // positive = earned, negative = spent
  reason      String   // BOOKING_EARN | BOOKING_SPEND | BOOKING_REFUND | REFERRAL | ADMIN | WELCOME
  note        String?
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model SupportTicket {
  id          String                 @id @default(cuid())
  reference   String                 @unique // e.g. "T-48213"
  openedById  String
  openedBy    User                   @relation("TicketOpener", fields: [openedById], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking?               @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  category    String                 // BOOKING_ISSUE | PAYMENT | SAFETY | ACCOUNT | OTHER
  subject     String
  status      String                 @default("OPEN") // OPEN | IN_PROGRESS | WAITING_ON_USER | RESOLVED | CLOSED
  priority    String                 @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  resolution  String?
  resolvedAt  DateTime?
  messages    SupportTicketMessage[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @default(now()) @updatedAt

  @@index([status, createdAt])
}

model SupportTicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  internal  Boolean       @default(false) // admin-only note
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// Web Push subscriptions (one per browser/device).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}
